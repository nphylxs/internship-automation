{
  "manifest_version": 3,
  "name": "Internship Desk",
  "version": "0.6.0",
  "minimum_chrome_version": "110",
  "description": "Collect internship listings and prepare tailored application documents in the background.",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "alarms", "unlimitedStorage"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_title": "Save internships and prepare applications", "default_popup": "popup.html"},
  "commands": {"save-listing": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the current internship without leaving the page"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "workspace.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
